# Server configuration
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/rentease

# JWT Secret key for token signing and verification
JWT_SECRET=your_jwt_secret_key_here

# Admin is created by `npm run seed` (public signup cannot choose the admin role).
# The seed script clears the database and adds sample users and items.
# Seed accounts all use the password 'password123', so do not seed production.
