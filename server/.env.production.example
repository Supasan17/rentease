# Example production settings for the RentEase API. Set these in the hosting
# dashboard (see render.yaml); never commit real values.

NODE_ENV=production

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rentease

# Long random string, different from the one used in development
JWT_SECRET=<long-random-secret>

# Deployed client URL. Separate several origins with commas.
CLIENT_URL=https://<your-client>.vercel.app

# Uploaded images are stored on the server's disk (server/uploads), so on hosts
# with a temporary filesystem they are lost when the service restarts.
